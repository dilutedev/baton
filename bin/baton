#!/usr/bin/env bash
# Starts and manages baton sessions. A session is one Claude Code session -
# the conductor - running in its own git worktree with agent teams enabled.
# You talk only to the conductor. It spawns the other roles (researcher,
# planner, principal, implementer, reviewer) as teammates, picks each one's
# model per task, stays in conversation with them while they work, and
# brings you the bottom line.
#
# Each role is a Claude Code agent definition generated from prompts/ into
# ~/.claude/agents/baton-<role>.md (see install_agents), so the conductor
# can spawn it by name with whatever model it chooses for that task.
#
# A directory can hold several sessions ("instances"), each with its own
# marker dir under $dir/.baton/s/<instance-id>/ and its own worktree. Once a
# session's conductor persists a backlog, the marker dir also gets a `slug`
# file so `baton status/resume/stop` can address it by name.
#
# Nothing here resumes a role's previous conversation: continuity comes from
# the kata backlog and the marker dir, which every fresh session reads.
set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$BIN_DIR/.." && pwd)"

ROLES=(researcher planner principal implementer reviewer)
PROMPT_DIR="${BATON_PROMPT_DIR:-$ROOT_DIR/prompts}"
GLOBAL_CONF="${BATON_CONF:-$ROOT_DIR/baton.conf}"
AGENTS_DIR="${BATON_AGENTS_DIR:-$HOME/.claude/agents}"
CLAUDE_BIN="${BATON_CLAUDE:-claude}"
MODEL_TIERS=(haiku sonnet opus)
AGENT_MARKER="# Generated by baton - edits are overwritten on the next baton start."

# Computed once, against this process's real stdout: fd 1 inside a `$(...)`
# is always a pipe, so checking at call time would never see a terminal.
BATON_USE_COLOR=0
[ -z "${NO_COLOR:-}" ] && [ -t 1 ] && BATON_USE_COLOR=1

usage() {
  cat <<'EOF'
Usage:
  baton start [--base BRANCH] [--workflow|-w feature|worktree] [--think] [--goal TEXT] [DIR]
                                       Start a new session for DIR (default: cwd) in its own git worktree,
                                       branched from BASE (default: the remote's default branch), and
                                       open the conductor (in this herdr pane, or a new herdr workspace)
  baton status [DIR]                   List every session for DIR, running or stopped
  baton resume [REF] [DIR]             Reopen a stopped session's conductor (fresh conversation, same session)
  baton stop [REF] [DIR]               End a running session's conductor
  baton remove [REF] [DIR]             Stop and delete a session's Baton files and its worktree
  baton cost [REF] [DIR]               Token use of a session, per model
  baton config [DIR]                   Show the resolved conductor and worker settings for DIR
  baton update                         Pull the latest baton from GitHub into this install

REF (a slug or session id) is optional when DIR has exactly one session.

Run from a herdr pane, the conductor opens in that pane; from anywhere else
with herdr running, baton opens a herdr workspace for it. Teammates run
inside the conductor's pane (arrow keys to pick one, Enter to view it and
message it). Settings live in baton.conf (next to this script's parent dir, or
$BATON_CONF), with per-project overrides in DIR/.baton/config.
EOF
}

# json_get <json> <dotted.path> -> the scalar at that path, or nothing.
json_get() {
  python3 -c '
import json, sys
try:
    d = json.loads(sys.argv[1])
except Exception:
    sys.exit(0)
for key in sys.argv[2].split("."):
    if isinstance(d, dict) and key in d:
        d = d[key]
    else:
        sys.exit(0)
if isinstance(d, (dict, list)):
    sys.exit(0)
print(d)
' "$1" "$2"
}

# require_deps -> exits 1 with a clear message if Claude Code or kata are
# missing. The conductor is a Claude Code session and kata holds the
# backlog, so failing here beats failing deep inside a run.
require_deps() {
  command -v "$CLAUDE_BIN" >/dev/null 2>&1 || {
    echo "baton: Claude Code ('$CLAUDE_BIN') is required but not on PATH - see https://code.claude.com/" >&2
    exit 1
  }
  command -v kata >/dev/null 2>&1 || {
    echo "baton: kata is required but not on PATH - see https://github.com/kenn-io/kata" >&2
    exit 1
  }
  [ "$(json_get "$(kata health --json 2>/dev/null)" ok)" = "True" ] || {
    echo "baton: kata is installed but its daemon isn't healthy - run 'kata health' to check" >&2
    exit 1
  }
}

# Resolves REF (a slug from an instance's `slug` file, a bare instance uuid,
# or empty) against $dir/.baton/s/* and prints the matching uuid.
resolve_instance() {
  local dir="$1" ref="$2"
  local base="$dir/.baton/s"
  [ -d "$base" ] || { echo "baton: no instances found for $dir" >&2; return 1; }

  if [ -n "$ref" ] && [ -d "$base/$ref" ]; then
    echo "$ref"
    return 0
  fi

  local matches=() d uuid
  for d in "$base"/*/; do
    [ -d "$d" ] || continue
    uuid="$(basename "$d")"
    if [ -n "$ref" ]; then
      [ -f "$d/slug" ] && [ "$(cat "$d/slug")" = "$ref" ] && matches+=("$uuid")
    else
      matches+=("$uuid")
    fi
  done

  case "${#matches[@]}" in
  0)
    echo "baton: no instance matching '${ref:-<any>}' in $dir - see 'baton status $dir'" >&2
    return 1
    ;;
  1)
    echo "${matches[0]}"
    return 0
    ;;
  *)
    echo "baton: '$ref' is ambiguous ($dir), matches: ${matches[*]} - specify the instance uuid directly" >&2
    return 1
    ;;
  esac
}

# Splits "$@" into a REF (anything that isn't an existing directory) and a
# DIR (anything that is), defaulting DIR to cwd. Sets globals REF and DIR.
parse_ref_dir_args() {
  DIR="."
  REF=""
  local arg
  for arg in "$@"; do
    if [ -d "$arg" ]; then
      DIR="$arg"
    else
      REF="$arg"
    fi
  done
  DIR="$(main_checkout_root "$(cd "$DIR" && pwd)")"
}

main_checkout_root() {
  local dir="$1" toplevel common main_root
  toplevel="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)" || { echo "$dir"; return; }
  common="$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || { echo "$dir"; return; }
  main_root="${common%/.git}"
  if [ "$common" != "$main_root" ] && [ "$toplevel" != "$main_root" ]; then
    echo "$main_root"
  else
    echo "$dir"
  fi
}

detect_default_base() {
  local repo="$1" remote_names="$2" remote_name
  if printf '%s\n' "$remote_names" | grep -qx origin; then
    remote_name=origin
  elif [ "$(printf '%s\n' "$remote_names" | grep -c .)" = 1 ]; then
    remote_name="$remote_names"
  else
    return 1
  fi
  git -C "$repo" symbolic-ref --short "refs/remotes/$remote_name/HEAD" 2>/dev/null
}

resolve_base() {
  local repo="$1" requested="$2" remote_names remote_count first_part
  BASE_REF="" BASE_REMOTE="" BASE_TARGET="" BASE_COMMIT=""
  remote_names="$(git -C "$repo" remote)"
  remote_count="$(printf '%s\n' "$remote_names" | grep -c . || true)"

  if [ -z "$requested" ]; then
    requested="$(detect_default_base "$repo" "$remote_names")" || {
      echo "baton: cannot determine the default base branch for $repo - pass --base <branch>" >&2
      return 1
    }
  fi

  first_part="${requested%%/*}"
  if [ "$first_part" != "$requested" ] && printf '%s\n' "$remote_names" | grep -qx -- "$first_part"; then
    BASE_REMOTE="$first_part"
    BASE_TARGET="${requested#*/}"
    git -C "$repo" fetch --quiet "$BASE_REMOTE" "+refs/heads/$BASE_TARGET:refs/remotes/$BASE_REMOTE/$BASE_TARGET" 2>/dev/null || {
      echo "baton: could not refresh branch '$BASE_TARGET' from remote '$BASE_REMOTE' - check the name and your network" >&2
      return 1
    }
    BASE_COMMIT="$(git -C "$repo" rev-parse --verify --quiet "refs/remotes/$BASE_REMOTE/$BASE_TARGET^{commit}")"
  elif BASE_COMMIT="$(git -C "$repo" rev-parse --verify --quiet "refs/heads/$requested^{commit}")"; then
    BASE_TARGET="$requested"
    case "$remote_count" in
    0) ;;
    1) BASE_REMOTE="$remote_names" ;;
    *)
      echo "baton: '$requested' is a local branch and this repository has several remotes ($(echo $remote_names)) - pass --base <remote>/$requested" >&2
      return 1
      ;;
    esac
  else
    echo "baton: base '$requested' is not a branch - use a local branch name or <remote>/<branch> (tags and commits can't be PR targets)" >&2
    return 1
  fi
  BASE_REF="$requested"
}

session_workflow() {
  local marker_dir="$1" recorded
  recorded="$(cat "$marker_dir/workflow" 2>/dev/null || true)"
  if [ -z "$recorded" ] && [ -f "$marker_dir/workflow_version" ]; then
    recorded="$(sed 's/-v1$//' "$marker_dir/workflow_version")"
    echo "$recorded" >"$marker_dir/workflow"
  fi
  echo "$recorded"
}

github_repo_for_remote() {
  local repo="$1" remote_name="$2" remote_url
  remote_url="$(git -C "$repo" config --get "remote.$remote_name.url" 2>/dev/null)" || return 1
  printf '%s\n' "$remote_url" |
    sed -nE 's#^(https?://([^@/]+@)?|ssh://([^@/]+@)?|[^@/]+@)github\.com[:/]+([^/]+/[^/]+)$#\4#p' |
    sed -E 's#\.git$##; s#/$##' |
    grep -E '^[^/]+/[^/]+$'
}

require_feature_prerequisites() {
  local repo="$1" remote_name="$2" github_repo
  command -v gh >/dev/null 2>&1 || {
    echo "baton: the feature workflow publishes one pull request and needs the GitHub CLI (gh) - install it, or start with --workflow worktree" >&2
    return 1
  }
  gh auth status >/dev/null 2>&1 || {
    echo "baton: the GitHub CLI is not authenticated - run 'gh auth login', or start with --workflow worktree" >&2
    return 1
  }
  github_repo="$(github_repo_for_remote "$repo" "$remote_name")" || {
    echo "baton: remote '$remote_name' is not a GitHub repository, which the feature workflow requires - start with --workflow worktree to skip the pull request" >&2
    return 1
  }
  echo "$github_repo"
}

# config_get <file> <key> -> last matching "key = value" line's value, if any.
config_get() {
  local file="$1" key="$2"
  [ -f "$file" ] || return 0
  grep -E "^[[:space:]]*${key}[[:space:]]*=" "$file" 2>/dev/null \
    | tail -n1 \
    | sed -E 's/^[^=]*=[[:space:]]*//; s/[[:space:]]*$//'
}

# resolve_setting <dir> <key> -> DIR/.baton/config, then $GLOBAL_CONF, then
# the built-in default.
resolve_setting() {
  local dir="$1" key="$2" val
  val="$(config_get "$dir/.baton/config" "$key")"; [ -n "$val" ] && { echo "$val"; return; }
  val="$(config_get "$GLOBAL_CONF" "$key")"; [ -n "$val" ] && { echo "$val"; return; }
  case "$key" in
  conductor.model) echo opus ;;
  conductor.effort) echo medium ;;
  worker.max-model) echo opus ;;
  teammate-mode) echo in-process ;;
  esac
}

# model_tier <model> -> its index in MODEL_TIERS, or nothing for a model
# baton doesn't rank.
model_tier() {
  local i
  for i in "${!MODEL_TIERS[@]}"; do
    [ "${MODEL_TIERS[$i]}" != "$1" ] || { echo "$i"; return; }
  done
}

# allowed_worker_models <dir> -> the models the conductor may give a
# teammate, cheapest first, capped by worker.max-model.
allowed_worker_models() {
  local cap_name cap i models=()
  cap_name="$(resolve_setting "$1" worker.max-model)"
  cap="$(model_tier "$cap_name")"
  [ -n "$cap" ] || {
    echo "baton: worker.max-model must be one of ${MODEL_TIERS[*]}, not '$cap_name'" >&2
    return 1
  }
  for i in "${!MODEL_TIERS[@]}"; do
    [ "$i" -le "$cap" ] && models+=("${MODEL_TIERS[$i]}")
  done
  echo "${models[*]}"
}

role_description() {
  case "$1" in
  researcher) echo "Baton researcher: investigates how the code works today and, for a reported problem, its root cause. Writes a Technical Brief." ;;
  planner) echo "Baton planner: settles product scope, user flows and acceptance criteria. Writes a Planning Brief." ;;
  principal) echo "Baton principal: weighs approaches, writes Solution Proposals and Implementation Designs, and advises the conductor on hard calls." ;;
  implementer) echo "Baton implementer: builds an approved design, verifies it and commits it, checking in with the conductor as it goes." ;;
  reviewer) echo "Baton reviewer: independently reviews an implementation or proposal and returns PASS or CHANGES REQUIRED with evidence." ;;
  esac
}

# role_default_model <role> -> the model a teammate gets when the conductor
# doesn't name one. The conductor normally does.
role_default_model() {
  case "$1" in
  principal) echo opus ;;
  *) echo sonnet ;;
  esac
}

# install_agents -> writes one Claude Code agent definition per role into
# $AGENTS_DIR: the role's prompt plus the shared team protocol. A file of
# the same name that baton didn't generate is left alone and reported.
install_agents() {
  local role file tmp
  mkdir -p "$AGENTS_DIR"
  for role in "${ROLES[@]}"; do
    [ -f "$PROMPT_DIR/$role.prompt.md" ] || { echo "baton: missing $PROMPT_DIR/$role.prompt.md" >&2; return 1; }
    file="$AGENTS_DIR/baton-$role.md"
    if [ -f "$file" ] && ! grep -qxF "$AGENT_MARKER" "$file"; then
      echo "baton: $file exists and wasn't generated by baton - move it aside so baton can install its $role" >&2
      return 1
    fi
    tmp="$(mktemp)"
    {
      printf -- '---\nname: baton-%s\ndescription: "%s"\nmodel: %s\n%s\n---\n\n' \
        "$role" "$(role_description "$role")" "$(role_default_model "$role")" "$AGENT_MARKER"
      cat "$PROMPT_DIR/$role.prompt.md"
      printf '\n---\n\n'
      cat "$PROMPT_DIR/team-protocol.md"
    } >"$tmp"
    mv "$tmp" "$file"
  done
}

# prepare_profile <dir> -> pre-accepts Claude Code's trust dialog for dir,
# and removes the Stop hook older baton releases registered (its script no
# longer exists, so it would fail on every turn).
prepare_profile() {
  local dir="$1"
  python3 - "$dir" "$HOME/.claude.json" "$HOME/.claude/settings.json" <<'PYEOF'
import json, os, sys

project_dir, state_file, settings_file = sys.argv[1:]

def load(path):
    try:
        with open(path) as file:
            return json.load(file)
    except FileNotFoundError:
        return {}

def save(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as file:
        json.dump(data, file, indent=2)
        file.write("\n")

state = load(state_file)
changed = False
# Claude Code looks trust up by the resolved path (macOS's /tmp is really
# /private/tmp), so cover both spellings.
for path in {project_dir, os.path.realpath(project_dir)}:
    project = state.setdefault("projects", {}).setdefault(path, {})
    if project.get("hasTrustDialogAccepted") is not True:
        project["hasTrustDialogAccepted"] = True
        changed = True
if changed:
    save(state_file, state)

settings = load(settings_file)
stop_hooks = settings.get("hooks", {}).get("Stop")
if stop_hooks:
    kept = []
    for group in stop_hooks:
        hooks = [h for h in group.get("hooks", []) if not h.get("command", "").endswith("hooks/baton-dispatch.sh")]
        if hooks:
            kept.append(dict(group, hooks=hooks))
    if kept != stop_hooks:
        if kept:
            settings["hooks"]["Stop"] = kept
        else:
            del settings["hooks"]["Stop"]
        save(settings_file, settings)
PYEOF
}

# in_flight_limit -> how many backlog items the conductor may have open at
# once: BATON_MAX_IN_FLIGHT when it is a whole number of 1 or more, else 2.
in_flight_limit() {
  case "${BATON_MAX_IN_FLIGHT:-}" in
  "" | *[!0-9]* | 0) echo 2 ;;
  *) echo "$BATON_MAX_IN_FLIGHT" ;;
  esac
}

# write_conductor_prompt <dir> <marker_dir> <work_dir> -> writes the
# conductor's system prompt (its persona plus this session's facts) to
# <marker_dir>/conductor.prompt.md and prints that path.
write_conductor_prompt() {
  local dir="$1" marker_dir="$2" work_dir="$3" file="$2/conductor.prompt.md" workflow models think=no
  workflow="$(session_workflow "$marker_dir")"
  models="$(allowed_worker_models "$dir")" || return 1
  { [ -f "$marker_dir/think" ] || [ "${BATON_THINK:-}" = 1 ]; } && think=yes
  {
    cat "$PROMPT_DIR/conductor.prompt.md"
    cat <<EOF

---

# This session

- Session id: \`$(basename "$marker_dir")\`
- Marker dir: \`$marker_dir\` (also \`\$BATON_MARKER_DIR\`)
- Worktree: \`$work_dir\` - you and every teammate work here, never in \`$dir\`
- Workflow: \`${workflow:-none}\`
- Session branch: \`$(cat "$marker_dir/session_branch" 2>/dev/null || echo none)\`, base \`$(cat "$marker_dir/base_ref" 2>/dev/null || echo none)\`
- Feature bookkeeping: \`$BIN_DIR/baton-item\` (on PATH as \`baton-item\`)
- Desktop notification: \`$BIN_DIR/baton-notify "<text>"\`
- Token report: \`$BIN_DIR/baton cost $(basename "$marker_dir") $dir\`
- Models you may give teammates, cheapest first: \`$models\`
- Items in flight at once: at most $(in_flight_limit)
- Item cap for this run: ${BATON_MAX_ITEMS:-none}
- Autonomous mode (\`--think\`): $think
EOF
  } >"$file"
  echo "$file"
}

# herdr_available -> true when herdr is installed and its server is running.
herdr_available() {
  command -v herdr >/dev/null 2>&1 &&
    [ "$(json_get "$(herdr status --json 2>/dev/null)" server.status)" = "running" ]
}

# instance_running <marker_dir> -> true while that session's conductor is
# alive: its process, when it runs in the terminal baton started from, or
# its herdr tab, when baton opened a herdr workspace for it.
instance_running() {
  local pid tab
  pid="$(cat "$1/pid" 2>/dev/null || true)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && ps -p "$pid" -o command= 2>/dev/null | grep -q claude; then
    return 0
  fi
  tab="$(cat "$1/tab_id" 2>/dev/null || true)"
  [ -n "$tab" ] && command -v herdr >/dev/null 2>&1 && herdr tab get "$tab" >/dev/null 2>&1
}

# stop_conductor <marker_dir> -> ends a running session's conductor, by
# closing the herdr workspace (or tab) it runs in or by signalling it.
stop_conductor() {
  local marker_dir="$1" tab workspace
  tab="$(cat "$marker_dir/tab_id" 2>/dev/null || true)"
  workspace="$(cat "$marker_dir/workspace_id" 2>/dev/null || true)"
  if [ -n "$tab" ] && command -v herdr >/dev/null 2>&1 && herdr tab get "$tab" >/dev/null 2>&1; then
    if [ "$(cat "$marker_dir/owns_workspace" 2>/dev/null || echo 1)" = 1 ] && [ -n "$workspace" ]; then
      herdr workspace close "$workspace" >/dev/null
    else
      herdr tab close "$tab" >/dev/null
    fi
  else
    kill "$(cat "$marker_dir/pid")"
  fi
}

# launch_in_herdr <marker_dir> <work_dir> <name> -> opens a herdr workspace
# for the session with the conductor in its one pane, then switches into
# herdr. Teammates run inside the conductor's pane: Claude Code only gives
# teammates panes of their own under tmux or iTerm2.
launch_in_herdr() {
  local marker_dir="$1" work_dir="$2" name="$3" flags=() var create_json workspace_id tab_id pane_id start_json attempt=0
  local agent="conductor-$(basename "$marker_dir")"
  for var in "${CONDUCTOR_ENV[@]}"; do flags+=(--env "$var"); done
  create_json="$(herdr workspace create --cwd "$work_dir" --label "$name" "${flags[@]}" --no-focus)" || return 1
  workspace_id="$(json_get "$create_json" result.workspace.workspace_id)"
  tab_id="$(json_get "$create_json" result.tab.tab_id)"
  pane_id="$(json_get "$create_json" result.root_pane.pane_id)"
  [ -n "$workspace_id" ] && [ -n "$tab_id" ] && [ -n "$pane_id" ] || {
    echo "baton: herdr didn't return a workspace, tab and pane - got: $create_json" >&2
    return 1
  }
  echo "$workspace_id" >"$marker_dir/workspace_id"
  echo "$tab_id" >"$marker_dir/tab_id"
  echo 1 >"$marker_dir/owns_workspace"
  herdr pane rename "$pane_id" conductor >/dev/null 2>&1 || true
  # A fresh pane briefly isn't at its shell prompt yet, which `agent start`
  # requires; retry only that fast-failing error.
  while :; do
    attempt=$((attempt + 1))
    start_json="$(herdr agent start "$agent" --kind claude --pane "$pane_id" --timeout 60000 -- "${CONDUCTOR_ARGS[@]}" 2>&1)" && break
    if [ "$(json_get "$start_json" error.code)" = "agent_pane_busy" ] && [ "$attempt" -lt 15 ]; then
      sleep 1
      continue
    fi
    echo "$start_json" >&2
    herdr workspace close "$workspace_id" >/dev/null 2>&1 || true
    rm -f "$marker_dir/workspace_id" "$marker_dir/tab_id" "$marker_dir/owns_workspace"
    return 1
  done
  echo "baton: the conductor is running in herdr workspace '$name'"
  herdr tab focus "$tab_id" >/dev/null 2>&1 || true
  exec herdr
}

# launch_conductor <dir> <marker_dir> <work_dir> [initial message] -> runs
# the conductor's Claude Code session. Inside a herdr pane (or without a
# running herdr) it replaces this process, in this terminal, so the
# recorded pid is the conductor's own; otherwise it opens a herdr workspace
# for it (see launch_in_herdr).
launch_conductor() {
  local dir="$1" marker_dir="$2" work_dir="$3" message="${4:-}" prompt_file name permission
  # Called from `cmd || handler` contexts, where errexit is off, so every
  # step checks its own failure before the exec.
  prepare_profile "$work_dir" || return 1
  install_agents || return 1
  prompt_file="$(write_conductor_prompt "$dir" "$marker_dir" "$work_dir")" || return 1
  name="baton-$(cat "$marker_dir/slug" 2>/dev/null || basename "$marker_dir")"
  CONDUCTOR_ARGS=(--model "$(resolve_setting "$dir" conductor.model)" --effort "$(resolve_setting "$dir" conductor.effort)"
    --teammate-mode "$(resolve_setting "$dir" teammate-mode)" --name "$name" --append-system-prompt-file "$prompt_file")
  permission="$(resolve_setting "$dir" permission-mode)"
  [ -z "$permission" ] || CONDUCTOR_ARGS+=(--permission-mode "$permission")
  [ -z "$message" ] || CONDUCTOR_ARGS+=("$message")
  CONDUCTOR_ENV=(CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1 "PATH=$BIN_DIR:$PATH"
    "BATON_ROOT=$work_dir" "BATON_MARKER_DIR=$marker_dir")
  rm -f "$marker_dir/pid" "$marker_dir/workspace_id" "$marker_dir/tab_id" "$marker_dir/owns_workspace"

  if [ -z "${HERDR_ENV:-}" ] && herdr_available; then
    launch_in_herdr "$marker_dir" "$work_dir" "$name"
    return
  fi
  echo "$$" >"$marker_dir/pid"
  cd "$work_dir"
  exec env "${CONDUCTOR_ENV[@]}" "$CLAUDE_BIN" "${CONDUCTOR_ARGS[@]}"
}

# resume_message <marker_dir> -> the conductor's first message on resume,
# so it picks the session back up instead of waiting to be told to.
resume_message() {
  local marker_dir="$1" session_label message goal_ref item_ref
  session_label="baton-session-$(basename "$marker_dir")"
  if [ -f "$marker_dir/slug" ]; then
    message="Resuming this session - no new goal from me. This session's backlog is exactly the kata issues labeled $session_label (its goal is labeled backlog-$(cat "$marker_dir/slug") too) and nothing else. Your teammates from before are gone; spawn fresh ones as you need them."
    if [ -f "$marker_dir/conductor-run" ]; then
      goal_ref="$(sed -n 1p "$marker_dir/conductor-run")"
      item_ref="$(sed -n 2p "$marker_dir/conductor-run")"
      message="$message Its goal issue is $goal_ref."
      [ -z "$item_ref" ] || message="$message The item last in flight was $item_ref - check its state in kata and the worktree before deciding what to do next."
    fi
    if [ -f "$marker_dir/proposal" ]; then
      message="$message This session is still in its proposal phase - nothing has been approved for building. Pick it up as your prompt's Proposal phase section describes."
    else
      message="$message Continue from wherever it left off."
    fi
  else
    message="Resuming this session - no goal has been given yet. Don't pick up other open kata issues; wait for my goal."
  fi
  echo "$message"
}

# Eight hex characters, from uuidgen when present and /dev/urandom otherwise.
new_instance_id() {
  if command -v uuidgen >/dev/null 2>&1; then
    uuidgen | tr 'A-Z' 'a-z' | cut -c1-8
  else
    od -An -N4 -tx1 /dev/urandom | tr -d ' \n'
  fi
}

cmd_start() {
  local think=0 dir="." requested_base="" workflow="" pr_repo="" goal=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
    --think) think=1 ;;
    --yes | -y) ;;
    --base)
      [ "$#" -ge 2 ] || { echo "baton: --base needs a branch" >&2; exit 1; }
      requested_base="$2"
      shift
      ;;
    --goal)
      [ "$#" -ge 2 ] || { echo "baton: --goal needs text" >&2; exit 1; }
      goal="$2"
      shift
      ;;
    --workflow | -w)
      [ "$#" -ge 2 ] || { echo "baton: --workflow needs feature or worktree" >&2; exit 1; }
      case "$2" in
      feature | worktree) workflow="$2" ;;
      *) echo "baton: unknown workflow '$2' - use feature or worktree" >&2; exit 1 ;;
      esac
      shift
      ;;
    -*) echo "baton: unknown start option '$1'" >&2; exit 1 ;;
    *) dir="$1" ;;
    esac
    shift
  done
  dir="$(main_checkout_root "$(cd "$dir" && pwd)")"
  git -C "$dir" rev-parse --show-toplevel >/dev/null 2>&1 || {
    echo "baton: $dir is not a git repository - sessions run in their own git worktree" >&2
    exit 1
  }
  resolve_base "$dir" "$requested_base" || exit 1
  [ -n "$workflow" ] || { [ -n "$BASE_REMOTE" ] && workflow=feature || workflow=worktree; }
  if [ "$workflow" = feature ]; then
    [ -n "$BASE_REMOTE" ] || {
      echo "baton: the feature workflow publishes to a remote and '$BASE_REF' has none - start with --workflow worktree" >&2
      exit 1
    }
    pr_repo="$(require_feature_prerequisites "$dir" "$BASE_REMOTE")" || exit 1
  fi
  allowed_worker_models "$dir" >/dev/null || exit 1
  git -C "$dir" cat-file -e "$BASE_COMMIT:.kata.toml" 2>/dev/null || {
    echo "baton: warning - .kata.toml isn't committed at $BASE_REF, so the session worktree won't be bound to your kata project; commit it first or the conductor will run 'kata init' inside the worktree" >&2
  }

  for role in "${ROLES[@]}" conductor; do
    [ -f "$PROMPT_DIR/$role.prompt.md" ] || {
      echo "baton: missing $PROMPT_DIR/$role.prompt.md" >&2
      exit 1
    }
  done

  if ! git -C "$dir" check-ignore -q .baton/; then
    local exclude_file
    exclude_file="$(git -C "$dir" rev-parse --path-format=absolute --git-path info/exclude)"
    mkdir -p "$(dirname "$exclude_file")"
    echo '.baton/' >>"$exclude_file"
    echo "baton: added .baton/ to $exclude_file"
  fi

  local instance
  instance="$(new_instance_id)"
  local marker_dir="$dir/.baton/s/$instance"
  local session_branch="baton/$instance"
  local worktree_path="${BATON_WORKTREE_DIR:-$HOME/.baton-worktrees}/$(basename "$dir")-$instance"
  mkdir -p "$marker_dir/reports" "$marker_dir/docs"
  if [ "$think" = 1 ]; then
    touch "$marker_dir/think"
  fi

  mkdir -p "$(dirname "$worktree_path")"
  git -C "$dir" worktree add --quiet -b "$session_branch" "$worktree_path" "$BASE_COMMIT" || {
    rm -r -- "$marker_dir"
    echo "baton: could not create the session worktree at $worktree_path" >&2
    exit 1
  }
  worktree_path="$(cd "$worktree_path" && pwd -P)"
  echo "$workflow" >"$marker_dir/workflow"
  [ -z "$pr_repo" ] || echo "$pr_repo" >"$marker_dir/pr_repo"
  echo "$session_branch" >"$marker_dir/session_branch"
  echo "$BASE_TARGET" >"$marker_dir/base_branch"
  echo "$BASE_REF" >"$marker_dir/base_ref"
  echo "$BASE_COMMIT" >"$marker_dir/base_commit"
  echo "$BASE_REMOTE" >"$marker_dir/remote"
  echo "$worktree_path" >"$marker_dir/worktree"
  # Lets baton-item find the session from inside the worktree when a
  # teammate's shell didn't inherit BATON_MARKER_DIR.
  echo "$marker_dir" >"$(git -C "$worktree_path" rev-parse --path-format=absolute --git-dir)/baton-marker"

  echo "baton: started session $instance for $dir"
  echo "  worktree: $worktree_path ($session_branch from $BASE_REF at ${BASE_COMMIT:0:12})"
  echo "  marker dir: $marker_dir"
  [ -n "$goal" ] || echo "  tell the conductor your goal, or describe the issue."

  launch_conductor "$dir" "$marker_dir" "$worktree_path" "$goal" || {
    echo "baton: startup failed - the checkout at $worktree_path is kept; 'baton resume $instance $dir' retries, 'baton remove $instance $dir' cleans up" >&2
    exit 1
  }
}

cmd_resume() {
  local args=() arg
  for arg in "$@"; do
    case "$arg" in
    --yes | -y) ;;
    *) args+=("$arg") ;;
    esac
  done
  parse_ref_dir_args "${args[@]+"${args[@]}"}"
  local instance
  instance="$(resolve_instance "$DIR" "$REF")" || exit 1

  local marker_dir="$DIR/.baton/s/$instance"
  if instance_running "$marker_dir"; then
    echo "baton: session '$instance' is already running - switch to it, or 'baton stop ${REF:-$instance}' first" >&2
    exit 1
  fi

  local work_dir="$DIR"
  if [ -n "$(session_workflow "$marker_dir")" ]; then
    work_dir="$(cat "$marker_dir/worktree" 2>/dev/null || true)"
    [ -n "$work_dir" ] && [ -d "$work_dir" ] || {
      echo "baton: the session checkout '$work_dir' is missing - 'baton remove $instance $DIR' discards this session" >&2
      exit 1
    }
    if [ "$(session_workflow "$marker_dir")" = "feature" ]; then
      local recorded_branch current_branch
      recorded_branch="$(cat "$marker_dir/session_branch" 2>/dev/null || true)"
      current_branch="$(git -C "$work_dir" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
      [ "$current_branch" = "$recorded_branch" ] || {
        echo "baton: the session checkout is on '$current_branch', not the session branch '$recorded_branch' - switch it back (or commit or stash first); resume does not move branches" >&2
        exit 1
      }
    fi
  fi

  echo "baton: resuming session $instance for $DIR"
  if [ "$(session_workflow "$marker_dir")" = "feature" ]; then
    BATON_MARKER_DIR="$marker_dir" "$BIN_DIR/baton-item" status || true
  fi
  launch_conductor "$DIR" "$marker_dir" "$work_dir" "$(resume_message "$marker_dir")"
}

cmd_stop() {
  parse_ref_dir_args "$@"
  local instance
  instance="$(resolve_instance "$DIR" "$REF")" || exit 1
  local marker_dir="$DIR/.baton/s/$instance"
  if instance_running "$marker_dir"; then
    stop_conductor "$marker_dir"
    echo "baton: stopped '$instance'"
  else
    echo "baton: session '$instance' isn't running"
  fi
}

registered_session_worktree() {
  local repo="$1" marker_dir="$2" worktree_path
  worktree_path="$(cat "$marker_dir/worktree" 2>/dev/null || true)"
  [ -n "$worktree_path" ] || { echo "baton: session has no recorded worktree" >&2; return 1; }
  [ -d "$worktree_path" ] || return 2
  if [ -L "$worktree_path" ]; then
    echo "baton: refusing to remove a worktree through a symlink: $worktree_path" >&2
    return 1
  fi
  worktree_path="$(cd "$worktree_path" && pwd -P)"
  [ "$worktree_path" != "$(cd "$repo" && pwd -P)" ] || {
    echo "baton: refusing to remove the primary checkout" >&2
    return 1
  }
  git -C "$repo" worktree list --porcelain | grep -qxF "worktree $worktree_path" || {
    echo "baton: $worktree_path is not a registered worktree of $repo" >&2
    return 1
  }
  echo "$worktree_path"
}

check_session_worktree_removable() {
  local repo="$1" marker_dir="$2" worktree_path status=0
  worktree_path="$(registered_session_worktree "$repo" "$marker_dir")" || status=$?
  [ "$status" = 2 ] && return 0
  [ "$status" = 0 ] || return 1
  if [ "$(session_workflow "$marker_dir")" = "feature" ]; then
    local session_branch local_tip remote_name remote_tip base_commit
    session_branch="$(cat "$marker_dir/session_branch")"
    remote_name="$(cat "$marker_dir/remote")"
    base_commit="$(cat "$marker_dir/base_commit")"
    local_tip="$(git -C "$worktree_path" rev-parse "refs/heads/$session_branch")"
    if [ "$local_tip" != "$base_commit" ]; then
      remote_tip="$(git -C "$worktree_path" ls-remote "$remote_name" "refs/heads/$session_branch" 2>/dev/null | awk '{print $1; exit}')"
      if [ "$remote_tip" != "$local_tip" ] && ! { [ -n "$remote_tip" ] && git -C "$worktree_path" merge-base --is-ancestor "$local_tip" "$remote_tip" 2>/dev/null; }; then
        echo "baton: commits on $session_branch are not published to $remote_name (or $remote_name is unreachable) - run 'baton-item publish' from the session, or push the branch, before removing" >&2
        return 1
      fi
    fi
  fi
  if [ -n "$(git -C "$worktree_path" status --porcelain 2>/dev/null)" ]; then
    echo "baton: $worktree_path has uncommitted changes - commit or discard them before removing this session" >&2
    return 1
  fi
  local ignored_entries
  ignored_entries="$(git -C "$worktree_path" status --porcelain --ignored 2>/dev/null | sed -n 's/^!! //p')"
  if [ -n "$ignored_entries" ]; then
    echo "baton: $worktree_path has ignored files that removal would delete - move or delete them first:" >&2
    printf '%s\n' "$ignored_entries" | head -n 10 | sed 's/^/  /' >&2
    return 1
  fi
}

remove_session_worktree() {
  local repo="$1" marker_dir="$2" worktree_path status=0
  worktree_path="$(registered_session_worktree "$repo" "$marker_dir")" || status=$?
  if [ "$status" = 2 ]; then
    git -C "$repo" worktree prune
  elif [ "$status" = 0 ]; then
    git -C "$repo" worktree remove -- "$worktree_path" || return 1
  else
    return 1
  fi
  echo "baton: kept branch $(cat "$marker_dir/session_branch" 2>/dev/null) (delete it with 'git branch -D' when no longer needed)"
}

cmd_remove() {
  parse_ref_dir_args "$@"
  local instance
  instance="$(resolve_instance "$DIR" "$REF")" || exit 1

  case "$instance" in
  *[!0123456789abcdef]*|"")
    echo "baton: invalid instance id '$instance'" >&2
    exit 1
    ;;
  esac
  [ "${#instance}" -eq 8 ] || { echo "baton: invalid instance id '$instance'" >&2; exit 1; }

  local marker_dir="$DIR/.baton/s/$instance"
  if [ -L "$DIR/.baton" ] || [ -L "$DIR/.baton/s" ] || [ -L "$marker_dir" ]; then
    echo "baton: refusing to remove an instance through a symlink: $marker_dir" >&2
    exit 1
  fi

  if [ -n "$(session_workflow "$marker_dir")" ]; then
    check_session_worktree_removable "$DIR" "$marker_dir" || exit 1
  fi

  if instance_running "$marker_dir"; then
    stop_conductor "$marker_dir" || exit 1
  fi

  if [ -n "$(session_workflow "$marker_dir")" ]; then
    remove_session_worktree "$DIR" "$marker_dir" || exit 1
  fi

  rm -r -- "$marker_dir"
  echo "baton: removed '$instance' from $DIR"
}

# use_color -> true for an interactive stdout (a human at a terminal), same
# convention as ls/grep --color=auto. NO_COLOR (no-color.org) and piped or
# redirected output (scripts, tests, log capture) both stay plain.
use_color() {
  [ "$BATON_USE_COLOR" = 1 ]
}

# paint <sgr-code> <text> -> <text> wrapped in that SGR code, or plain if
# use_color says no. SGR codes, not names, since this is the only place
# they're used and a lookup table would be indirection with one caller.
paint() {
  if use_color; then
    printf '\033[%sm%s\033[0m' "$1" "$2"
  else
    printf '%s' "$2"
  fi
}

# instance_state_sgr <state> -> the SGR code paint should use for it.
instance_state_sgr() {
  case "$1" in
  running) echo "32" ;; # green
  *) echo "90" ;; # gray
  esac
}

# render_backlog <dir> <slug> <session> -> the run's backlog items, one per line as
# "[x] <short_id>  <title>" (closed vs open), indented for cmd_status. Reads
# `kata list --json` rather than the `--agent` key=value text (open=…
# owner=andy labels=backlog-<slug> … revision=1 repeated on every line) -
# that format is a contract for agents parsing kata output programmatically,
# not for a human skimming `baton status`.
render_backlog() {
  local dir="$1" slug="$2" session="$3" color_flag="0" json
  if use_color; then
    color_flag="1"
  fi
  command -v kata >/dev/null 2>&1 || return 0
  json="$(cd "$dir" && kata list --label "backlog-$slug" --label "baton-session-$session" --no-label baton-backlog --status all --json 2>/dev/null || true)"
  [ -n "$json" ] || return 0
  python3 -c '
import json, sys

data, color = sys.argv[1], sys.argv[2] == "1"

def paint(code, text):
    return "\033[" + code + "m" + text + "\033[0m" if color else text

try:
    issues = json.loads(data).get("issues", [])
except Exception:
    sys.exit(0)

if not issues:
    print("    (no backlog items yet)")
    sys.exit(0)

closed_count = sum(1 for item in issues if item.get("status") == "closed")
print("    " + paint("32", str(closed_count) + " closed") + " / " + str(len(issues)) + " total")
for item in issues:
    mark = paint("32", "x") if item.get("status") == "closed" else " "
    print("    [" + mark + "] " + item.get("short_id", "?") + "  " + item.get("title", "?"))
' "$json" "$color_flag"
}

cmd_status() {
  local dir="${1:-.}"
  dir="$(main_checkout_root "$(cd "$dir" && pwd)")"

  local base="$dir/.baton/s"
  local d uuid slug state found=0
  if [ -d "$base" ]; then
    for d in "$base"/*/; do
      [ -d "$d" ] || continue
      found=1
      uuid="$(basename "$d")"
      slug="(no goal yet)"
      if [ -f "$d/slug" ]; then
        slug="$(cat "$d/slug")"
      fi
      state="stopped"
      if instance_running "${d%/}"; then
        state="running"
      fi

      printf '%s  %s  %s\n' "$(paint 1 "$uuid")" "$(paint "$(instance_state_sgr "$state")" "$state")" "$slug"
      if [ -n "$(session_workflow "$d")" ]; then
        printf '  workflow %s  branch %s  base %s@%s\n  worktree %s\n' "$(session_workflow "$d")" \
          "$(cat "$d/session_branch" 2>/dev/null)" "$(cat "$d/base_ref" 2>/dev/null)" \
          "$(cut -c1-12 "$d/base_commit" 2>/dev/null)" "$(cat "$d/worktree" 2>/dev/null)"
        if [ "$(session_workflow "$d")" = "feature" ]; then
          printf '  pull request %s' "$(cat "$d/pr_url" 2>/dev/null || echo none)"
          [ ! -f "$d/final/phase" ] || printf '  finalization %s' "$(cat "$d/final/phase")"
          echo
        fi
      fi
      [ ! -f "$d/proposal" ] || echo "  proposal phase: waiting for the proposal or your approval"

      if [ -f "$d/slug" ]; then
        render_backlog "$dir" "$slug" "$uuid"
      fi
      echo
    done
  fi

  [ "$found" = "1" ] || echo "baton: no instances for $dir"
}

# cmd_cost [REF] [DIR] -> the session's token use per model, summed from
# the Claude Code transcripts of every session that ran in its worktree
# (the conductor and its teammates alike).
cmd_cost() {
  parse_ref_dir_args "$@"
  local instance marker_dir work_dir
  instance="$(resolve_instance "$DIR" "$REF")" || exit 1
  marker_dir="$DIR/.baton/s/$instance"
  work_dir="$(cat "$marker_dir/worktree" 2>/dev/null || echo "$DIR")"
  python3 - "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects" "$work_dir" <<'PYEOF'
import glob, json, os, re, sys

projects, work_dir = sys.argv[1:]
paths = {work_dir, os.path.realpath(work_dir)}
files = set()
for path in paths:
    project = os.path.join(projects, re.sub(r"[^A-Za-z0-9]", "-", path))
    files.update(glob.glob(os.path.join(project, "**", "*.jsonl"), recursive=True))

totals, seen = {}, set()
for name in sorted(files):
    with open(name, errors="replace") as transcript:
        for line in transcript:
            try:
                entry = json.loads(line)
            except ValueError:
                continue
            message = entry.get("message") if isinstance(entry, dict) else None
            if entry.get("type") != "assistant" or not isinstance(message, dict):
                continue
            usage, key = message.get("usage"), message.get("id")
            if not usage or key in seen:
                continue
            seen.add(key)
            row = totals.setdefault(message.get("model", "unknown"), [0, 0, 0, 0, 0])
            row[0] += 1
            row[1] += usage.get("input_tokens", 0)
            row[2] += usage.get("cache_creation_input_tokens", 0)
            row[3] += usage.get("cache_read_input_tokens", 0)
            row[4] += usage.get("output_tokens", 0)

if not totals:
    print("baton: no Claude Code transcripts found for " + work_dir)
    sys.exit(0)
print("%-28s %8s %12s %12s %14s %10s" % ("model", "requests", "input", "cache write", "cache read", "output"))
for model, row in sorted(totals.items(), key=lambda item: -item[1][4]):
    print("%-28s %8d %12d %12d %14d %10d" % (model, *row))
PYEOF
}

# cmd_update -> fast-forwards the git checkout this script runs from
# (ROOT_DIR, normally ~/.baton) to its upstream branch, so updating doesn't
# mean cd'ing there and pulling by hand. Deliberately conservative: refuses
# on local edits to tracked files, a detached HEAD, or a branch with no
# upstream, and never merges or rebases - every case it won't handle is one
# where pulling could silently lose or tangle something.
cmd_update() {
  local git_dir=(git -C "$ROOT_DIR") branch before after
  "${git_dir[@]}" rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    echo "baton: $ROOT_DIR isn't a git checkout, so there's nothing to update - reinstall with git clone" >&2
    exit 1
  }
  if [ -n "$("${git_dir[@]}" status --porcelain --untracked-files=no)" ]; then
    echo "baton: $ROOT_DIR has local changes - commit or stash them first:" >&2
    "${git_dir[@]}" status --short --untracked-files=no >&2
    exit 1
  fi
  branch="$("${git_dir[@]}" symbolic-ref --quiet --short HEAD)" || {
    echo "baton: $ROOT_DIR isn't on a branch - run: git -C $ROOT_DIR checkout main" >&2
    exit 1
  }
  "${git_dir[@]}" rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1 || {
    echo "baton: branch '$branch' in $ROOT_DIR doesn't track a remote branch - run: git -C $ROOT_DIR checkout main" >&2
    exit 1
  }

  before="$("${git_dir[@]}" rev-parse HEAD)"
  # Fetch and fast-forward separately, so being offline isn't reported as
  # a diverged branch.
  "${git_dir[@]}" fetch --quiet || {
    echo "baton: couldn't reach $ROOT_DIR's remote (see git's error above) - check your connection and try again" >&2
    exit 1
  }
  "${git_dir[@]}" merge --ff-only --quiet '@{upstream}' 2>/dev/null || {
    echo "baton: couldn't fast-forward '$branch' in $ROOT_DIR (it has commits upstream doesn't) - sort it out with git there" >&2
    exit 1
  }
  after="$("${git_dir[@]}" rev-parse HEAD)"

  if [ "$before" = "$after" ]; then
    echo "baton: already up to date ($branch at $("${git_dir[@]}" rev-parse --short HEAD))"
    return 0
  fi
  echo "baton: updated $ROOT_DIR ($branch):"
  "${git_dir[@]}" log --oneline --no-decorate "$before..$after" | sed 's/^/  /'
  echo "Running instances keep the version they started with until you 'baton stop' and 'baton resume' them."
}

cmd_config() {
  local dir="${1:-.}" role
  dir="$(cd "$dir" && pwd)"
  printf 'conductor        model=%s effort=%s\n' "$(resolve_setting "$dir" conductor.model)" "$(resolve_setting "$dir" conductor.effort)"
  printf 'worker models    %s (the conductor picks one per task)\n' "$(allowed_worker_models "$dir" || echo invalid)"
  for role in "${ROLES[@]}"; do
    printf '  %-12s   default %s\n' "$role" "$(role_default_model "$role")"
  done
  printf 'teammate-mode    %s\n' "$(resolve_setting "$dir" teammate-mode)"
  printf 'permission-mode  %s\n' "$(resolve_setting "$dir" permission-mode | grep . || echo "(Claude Code's default)")"
  printf 'agents           %s/baton-<role>.md\n' "$AGENTS_DIR"
}

case "${1:-}" in
start | resume)
  require_deps
  command="$1"
  shift
  "cmd_$command" "$@"
  ;;
stop | remove | status | cost | config)
  command="$1"
  shift
  "cmd_$command" "$@"
  ;;
update)
  cmd_update
  ;;
*)
  usage
  exit 1
  ;;
esac
