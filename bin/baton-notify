#!/usr/bin/env bash
# baton-notify "<text>"
# Shows a desktop notification - the conductor runs it whenever it stops and
# needs the user. Where the platform has no way to show one, it rings the
# terminal bell instead. Never fails the caller.
set -uo pipefail

text="$(echo "$*" | tr '\n\t' '  ' | sed -E 's/[[:space:]]+$//')"
[ -n "$text" ] || {
  echo "baton-notify: usage: baton-notify <text>" >&2
  exit 1
}

if command -v osascript >/dev/null 2>&1; then
  osascript -e 'on run argv' -e 'display notification (item 1 of argv) with title "baton"' -e 'end run' "$text" >/dev/null 2>&1
elif command -v notify-send >/dev/null 2>&1; then
  notify-send baton "$text" >/dev/null 2>&1
else
  printf '\a' >/dev/tty 2>/dev/null
fi
exit 0
